rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Strategy Sweeps Collection Rules
    match /strategy_sweeps/{sweepId} {
      // Allow read access for real-time dashboard listeners
      allow read: if true;
      
      // Strict creation rule enforcing StrategySweep entity schema
      allow create: if request.resource.data.keys().hasAll(['sweepId', 'symbol', 'status', 'createdAt'])
                   && request.resource.data.sweepId is string
                   && request.resource.data.symbol is string
                   && request.resource.data.status in ['processing', 'completed', 'failed']
                   && request.resource.data.createdAt is number;
                   
      // Prevent client-side updates or deletions (server-admin manages lifecycle)
      allow update, delete: if false;
    }

    // Default fallback rules
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
