# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NVIDIA_API_KEY: Required for AI trade signals
NVIDIA_API_KEY="YOUR_NVIDIA_API_KEY"

# DATABASE_URL: Required for database connection (e.g. postgresql://user:password@host:port/dbname)
DATABASE_URL="YOUR_DATABASE_URL"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EXCHANGERATE_API_KEY: Required for ExchangeRate-API (Forex)
EXCHANGERATE_API_KEY="YOUR_EXCHANGERATE_API_KEY"

# POLYGON_API_KEY: Required for Forex live data
POLYGON_API_KEY="YOUR_POLYGON_API_KEY"

# FINNHUB_API_KEY: Required for live news sentiment
FINNHUB_API_KEY="YOUR_FINNHUB_API_KEY"

# CTRADER_CLIENT_ID: Required for cTrader integration
CTRADER_CLIENT_ID="YOUR_CTRADER_CLIENT_ID"

# CTRADER_CLIENT_SECRET: Required for cTrader integration
CTRADER_CLIENT_SECRET="YOUR_CTRADER_CLIENT_SECRET"

# CTRADER_ACCESS_TOKEN: Required for cTrader integration
CTRADER_ACCESS_TOKEN="YOUR_CTRADER_ACCESS_TOKEN"

# FIREBASE_SERVICE_ACCOUNT: Required for Firestore/Firebase Admin SDK (JSON string)
FIREBASE_SERVICE_ACCOUNT="YOUR_FIREBASE_SERVICE_ACCOUNT_JSON"


# RAPIDAPI_KEY / X_RAPIDAPI_KEY: Optional RapidAPI key for third-party endpoints
RAPIDAPI_KEY="YOUR_RAPIDAPI_KEY"
X_RAPIDAPI_KEY="YOUR_RAPIDAPI_KEY"

# Pusher for WebSockets (Free)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=
