{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "node_modules/@reiryoku/ctrader-layer/protobuf/*",
        "firebase-applet-config.json"
      ]
    }
  }
}
